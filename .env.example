HTTP_ADDR=0.0.0.0:8000
# MongoDB sin autenticación (desarrollo local pdf-infra):
MONGO_URL=mongodb://mongo:27017/pdf_persistence
# MongoDB con autenticación (staging / producción / standalone):
# MONGO_URL=mongodb://root:example@mongo:27017/pdf_persistence?authSource=admin
MONGO_DB_NAME=pdf_persistence
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_TTL=604800
REDIS_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=1.0
LOG_LEVEL=info
PDF_PERSISTANCE_REPLICAS=1

